{
	"schemaVersion": 1,
	"id": "rounded_edges",
	"version": "${version}",
	"name": "Rounded Edges",
	"description": "Carves a small stepped bevel into the exposed edges of natural terrain, logs and leaves. Real geometry, no options, client-side only.",
	"authors": [
		"James Debono"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/rounded-edges",
		"sources": "https://github.com/james-debono/rounded-edges",
		"issues": "https://github.com/james-debono/rounded-edges/issues"
	},
	"license": "MIT",
	"icon": "assets/rounded_edges/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.jamesdebono.roundededges.client.RoundedEdgesClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": ">=0.161.0"
	}
}
